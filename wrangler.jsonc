{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recalm-api-cost-check",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "public", "binding": "ASSETS", "run_worker_first": ["/v1/*"]},
  "observability": {"enabled": false},
  "vars": {"API_ENABLED": "false"},
  "durable_objects": {"bindings": [{"name": "ACCOUNTS", "class_name": "AccountMeter"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["AccountMeter"]}]
}
