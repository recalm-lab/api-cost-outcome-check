{
  "openapi": "3.1.0",
  "info": {
    "title": "Recalm API Cost Check",
    "version": "0.2.0",
    "description": "Development contract; not a live sales offer. One declared provider/account/time scope and owner-defined success criterion. Explicit joins only; no fraud/refund conclusions. No input persistence or external model calls. No production server URL configured. Approved commercial terms: JPY 1 tax-inclusive per success, monthly arrears, below JPY 50 carried forward, below JPY 50 waived on cancellation, monthly JPY 1000 stop. Not activated."
  },
  "paths": {
    "/v1/check": {
      "post": {
        "operationId": "checkCostOutcome",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{16,128}$"
            },
            "description": "Opaque client-generated identifier unique per logical call. Retry with identical UTF-8 body. Account scoped; retained while account namespace and HMAC key remain intact."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                    "maxLength": 64
                  },
                  "successCriterion": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                    "maxLength": 64
                  },
                  "tasks": {
                    "type": "array",
                    "maxItems": 40,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                          "maxLength": 64
                        },
                        "outcome": {
                          "type": "string",
                          "enum": [
                            "success",
                            "failure",
                            "unknown"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "outcome"
                      ]
                    }
                  },
                  "attempts": {
                    "type": "array",
                    "maxItems": 40,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "requestId": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                          "maxLength": 64
                        },
                        "taskId": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                          "maxLength": 64
                        },
                        "outcome": {
                          "type": "string",
                          "enum": [
                            "success",
                            "failure",
                            "unknown"
                          ]
                        },
                        "retryOf": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                          "maxLength": 64
                        }
                      },
                      "required": [
                        "requestId",
                        "taskId",
                        "outcome"
                      ]
                    }
                  },
                  "bills": {
                    "type": "array",
                    "maxItems": 40,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                          "maxLength": 64
                        },
                        "requestId": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                          "maxLength": 64
                        },
                        "amount": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000000
                        },
                        "unit": {
                          "type": "string",
                          "pattern": "^(money:[A-Z]{3}:[0-6]|credits:[A-Za-z0-9_.-]{1,32}:[0-6])$",
                          "description": "Integer smallest unit. money:USD:2 amount 20 = USD 0.20; money:JPY:0 amount 1 = JPY 1; credits:vendor:0 is a separate vendor credit unit. No conversion or currency validation."
                        },
                        "evidence": {
                          "type": "string",
                          "enum": [
                            "confirmed",
                            "estimated",
                            "unknown"
                          ]
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "usage",
                            "topup",
                            "balance"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "amount",
                        "unit",
                        "evidence",
                        "kind"
                      ]
                    }
                  }
                },
                "required": [
                  "scope",
                  "successCriterion",
                  "tasks",
                  "attempts",
                  "bills"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completed reconciliation and atomic usage receipt. Unknown results are valid completed calls. This does not collect payment. A replay recomputes the result without incrementing usage.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "result": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "algorithmVersion": {
                          "const": "1"
                        },
                        "scope": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                          "maxLength": 64
                        },
                        "successCriterion": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                          "maxLength": 64
                        },
                        "successfulTasks": {
                          "type": "integer"
                        },
                        "totals": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "unit": {
                                "type": "string",
                                "pattern": "^(money:[A-Z]{3}:[0-6]|credits:[A-Za-z0-9_.-]{1,32}:[0-6])$",
                                "description": "Integer smallest unit. money:USD:2 amount 20 = USD 0.20; money:JPY:0 amount 1 = JPY 1; credits:vendor:0 is a separate vendor credit unit. No conversion or currency validation."
                              },
                              "evidence": {
                                "type": "string",
                                "enum": [
                                  "confirmed",
                                  "estimated",
                                  "unknown"
                                ]
                              },
                              "total": {
                                "type": "integer"
                              },
                              "attributable": {
                                "type": "integer"
                              },
                              "unknown": {
                                "type": "integer"
                              },
                              "duplicateSuspected": {
                                "type": "boolean"
                              },
                              "attributionComplete": {
                                "type": "boolean"
                              },
                              "costPerSuccessfulTask": {
                                "oneOf": [
                                  {
                                    "type": "null"
                                  },
                                  {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                      "numerator": {
                                        "type": "integer"
                                      },
                                      "denominator": {
                                        "type": "integer",
                                        "minimum": 1
                                      }
                                    },
                                    "required": [
                                      "numerator",
                                      "denominator"
                                    ]
                                  }
                                ]
                              }
                            },
                            "required": [
                              "unit",
                              "evidence",
                              "total",
                              "attributable",
                              "unknown",
                              "duplicateSuspected",
                              "attributionComplete",
                              "costPerSuccessfulTask"
                            ]
                          }
                        },
                        "findings": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "billId": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                                "maxLength": 64
                              },
                              "attribution": {
                                "type": "string",
                                "enum": [
                                  "explicit_request_id",
                                  "unknown"
                                ]
                              },
                              "taskId": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                                "maxLength": 64
                              },
                              "requestId": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                                "maxLength": 64
                              },
                              "flags": {
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "enum": [
                                    "excluded_non_usage",
                                    "unknown_attribution",
                                    "duplicate_suspected",
                                    "failed_retry",
                                    "unknown_task_outcome"
                                  ]
                                }
                              }
                            },
                            "required": [
                              "billId",
                              "attribution",
                              "flags"
                            ]
                          }
                        },
                        "notice": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "algorithmVersion",
                        "scope",
                        "successCriterion",
                        "successfulTasks",
                        "totals",
                        "findings",
                        "notice"
                      ]
                    },
                    "usage": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "billableCalls": {
                          "type": "integer",
                          "enum": [
                            0,
                            1
                          ]
                        },
                        "replay": {
                          "type": "boolean"
                        },
                        "successfulCalls": {
                          "type": "integer"
                        },
                        "proposedUnitPrice": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "amount": {
                              "const": 1
                            },
                            "unit": {
                              "const": "money:JPY:0"
                            }
                          },
                          "required": [
                            "amount",
                            "unit"
                          ]
                        },
                        "paymentCollected": {
                          "const": false
                        },
                        "successfulCallsThisMonth": {
                          "type": "integer",
                          "description": "Current UTC month count, shared by all credentials for this account"
                        }
                      },
                      "required": [
                        "billableCalls",
                        "replay",
                        "successfulCalls",
                        "proposedUnitPrice",
                        "paymentCollected",
                        "successfulCallsThisMonth"
                      ]
                    }
                  },
                  "required": [
                    "result",
                    "usage"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON, schema or idempotency key; not metered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, disabled or unknown credential; not metered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Unknown route",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Same account/key used with a different byte-exact body or algorithm version; not metered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 16384 UTF-8 bytes; not metered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "415": {
            "description": "Wrong content type or compressed input; not metered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Monthly account contract cap (at most 1000) or lifetime receipt safety ceiling reached; not metered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "API disabled, unconfigured or unavailable; not a new successful receipt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "408": {
            "description": "Body read deadline of 2 seconds exceeded; not metered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "const": "timeout"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Separately authorized high-entropy customer credential, hash-only registry. Not issued in this release."
      }
    }
  }
}
